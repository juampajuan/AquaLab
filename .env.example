# Copiar a .env (cp .env.example .env) y completar. .env NO se sube al repo.

# Generar una propia, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-una-clave-secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Credenciales de la base local de Docker (las usa el servicio "db").
POSTGRES_DB=aqualab
POSTGRES_USER=aqualab
POSTGRES_PASSWORD=aqualab

# Habilita comandos solo de desarrollo, como cargar_demo. En Render vale «produccion» (render.yaml).
AQUALAB_ENTORNO=desarrollo

# Dentro de Docker el host de la base es "db".
DATABASE_URL=postgres://aqualab:aqualab@db:5432/aqualab

# Correo (US 1.3). Por defecto los avisos se muestran en la consola (docker compose logs -f web).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AquaLab <no-responder@aqualab.local>
# Base de los enlaces de los correos que no salen de un pedido web (aviso de desvíos, US 8.2).
AQUALAB_URL_BASE=http://localhost:8000

# Para enviarlos de verdad, por ejemplo con Gmail y una contraseña de aplicación
# (https://support.google.com/accounts/answer/185833), descomentar y completar.
# Las credenciales van solo en .env, nunca en el repo.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=la-contraseña-de-aplicación
# DEFAULT_FROM_EMAIL=AquaLab <tu-cuenta@gmail.com>

# Asistente de consultas (US 10.1). Vacío: el asistente aparece deshabilitado y AquaLab funciona
# igual. Clave gratuita en https://console.groq.com. Por defecto usa Groq; para otro servicio
# compatible con OpenAI, descomentar y completar.
ASISTENTE_API_KEY=
# ASISTENTE_URL=https://api.groq.com/openai/v1/chat/completions
# ASISTENTE_MODELO=openai/gpt-oss-120b
